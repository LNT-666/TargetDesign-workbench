# Normalise line endings in the repository; keep shell scripts LF for Linux.
* text=auto
*.sh text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.pdf binary
*.npz binary
*.ggi binary
*.h5 binary
*.pth binary
*.pt binary

# Test fixtures are compared byte for byte, so keep them out of the
# line-ending conversion that ``* text=auto`` turns on.
tests/data/** -text
