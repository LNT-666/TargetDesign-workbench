logs/
out/
backup/
*.log
server_bundle.zip
workspace.json
basic/out/
shared/logs/
shared/output/
webapp/jobs/
_srv.*.txt
_probe_*.js

# ---- Large local datasets (redistributed separately, see docs/) ----------
# scy-test/  : ~65 GB case-study working data
# example/   : 3.3 GB GRCh38 FASTA plus derived indexes.
#              Only the small, submission-named evidence files under
#              example/engine_benchmark_small/ ship with the release; the
#              genomes, indexes and full benchmark runs stay excluded.
#              See docs/RELEASE_CONTENTS.md section 2.
scy-test/
# example/ is excluded as a whole directory. Git cannot re-include a file
# whose parent directory is excluded, so re-inclusion is done level by level:
# exclude every entry, re-include the one small benchmark directory, exclude
# its contents, then re-include the six submission-named evidence files.
/example/*
!/example/engine_benchmark_small/
/example/engine_benchmark_small/*
!/example/engine_benchmark_small/REPORT.md
!/example/engine_benchmark_small/fixture.json
!/example/engine_benchmark_small/guides.tsv
!/example/engine_benchmark_small/results_*.json
genome_index/

