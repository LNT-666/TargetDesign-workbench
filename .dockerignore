native/build*/
native/bin/
*.exe

# Agent and editor working directories (same policy as .gitignore).
.codex/
.codex_tmp/
.vscode/
.idea/

# Internal-only material: manuscript, release records and handoff notes.
# A CI build copies the git checkout, which never contains these; the list
# below keeps a local `docker build .` from shipping them too.
docs/PAPER_*.md
docs/ALLEGRO_REFERENCE_ANALYSIS.md
docs/EXPRESSIVENESS_MATRIX.md
docs/FIGURE_TABLE_PLAN.md
docs/GRAPHICAL_ABSTRACT_SPEC.md
